      "/imgs/tejas4/1.jpg",
      "/imgs/tejas4/2.jpg",
      "/imgs/tejas4/3.jpg",
      "/imgs/tejas4/4.jpg",
    ],
    characteristics: [
      "🚗 Cochera cubierta para 2 vehículos y extras",
