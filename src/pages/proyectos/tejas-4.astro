  },
  detalles: [
    { label: "Sup. Terreno", value: "350,40 m²" },
    { label: "Sup. Cubierta", value: "125,18 m²" },
    { label: "Sup. Semicubierta", value: "30,98 m²" },
    { label: "Sup. Total", value: "156,11 m²" },
    { label: "Antigüedad", value: "A estrenar" },
    { label: "Garage", value: "2 vehículos" },
    { label: "Dormitorios", value: "2" },
    { label: "Estudio", value: "1" },
    { label: "Baños", value: "2" },
    { label: "Toilette", value: "1" },
    { label: "Ambientes", value: "5" },
  ],
  financiamiento: {
    showPrecioTitle: false,
    showEntregaCuotas: false,
    estadoBadge: "A estrenar",
    slogan: "¿Te interesa? Escribinos y te contamos todos los detalles.",
    whatsappMessage: "Hola, me interesa la casa de 2 dormitorios en Tejas 4. ¿Podrían darme más información?",
    phone: "5493517659117",
    buttonText: "Consultá por esta propiedad",
  },
  footer: {
    projectName: "Tejas 4",
    projectNameHighlight: "4",
    projectDescription: "Casa de 2 dormitorios en Tejas 4. Una vivienda con diseño arquitectónico, excelente calidad ambiental y contacto 100% con la naturaleza. Servicios: agua corriente, luz, gas.",
