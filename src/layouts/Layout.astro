---
// import FooterTop from "../components/FooterTop.astro";
// import Navbar from "../components/Navbar";
// import FooterMed from "../components/FooterMed.astro";
// import FooterBottom from "../components/FooterBottom.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>BZN Urban Making | Desarrollista Inmobiliaria en Córdoba</title>

    <meta
      name="description"
      content="BZN Urban Making es una desarrollista con más de 40 años de trayectoria en Córdoba. Ejecutamos, proyectamos y comercializamos edificios de alta gama que potencian la inversión inmobiliaria."
    />
    <meta
      name="keywords"
      content="BZN, desarrollista, desarrollos inmobiliarios, Córdoba, edificios, departamentos, inversión, arquitectura, bienes raíces, Miguel Ángel Bazán"
    />
    <meta name="author" content="BZN Urban Making" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://www.bznurbanmaking.com/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="BZN Urban Making | Desarrollista Inmobiliaria en Córdoba"
    />
    <meta
      property="og:description"
      content="Somos una desarrollista con más de 40 años de experiencia. Invertí en bienes raíces con proyectos de calidad y visión a futuro."
    />
    <meta
      property="og:image"
      content="https://www.bznurbanmaking.com/imgs/og-image.jpg"
    />
    <meta property="og:url" content="https://www.bznurbanmaking.com/" />
    <meta property="og:site_name" content="BZN Urban Making" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content="BZN Urban Making | Desarrollista Inmobiliaria en Córdoba"
    />
    <meta
      name="twitter:description"
      content="40 años desarrollando proyectos inmobiliarios de alta gama en Córdoba."
    />
    <meta
      name="twitter:image"
      content="https://www.bznurbanmaking.com/imgs/og-image.jpg"
    />

    <!-- Accesibilidad y rendimiento -->
    <!-- <meta name="theme-color" content="#08202E" />
    <meta name="color-scheme" content="dark light" /> -->
    <meta name="application-name" content="BZN Urban Making" />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/webp"
      href="/public/imgs/logos/logo_reducido.webp"
    />

    <!-- Datos estructurados con Schema.org -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "RealEstateAgent",
        "name": "BZN Urban Making",
        "url": "https://www.bznurbanmaking.com",
        "logo": "https://www.bznurbanmaking.com/favicon.svg",
        "description": "Desarrollista inmobiliaria con más de 40 años de trayectoria en Córdoba. Edificios de alta gama para inversión.",
        "areaServed": {
          "@type": "Place",
          "name": "Córdoba, Argentina"
        },
        "founder": {
          "@type": "Person",
          "name": "Miguel Ángel Bazán"
        }
      }
    </script>
  </head>
  <body>
    <main>
      <section aria-label="Presentación de BZN Urban Making">
        <h1 style="display: none;">
          BZN Urban Making - Desarrollista inmobiliaria en Córdoba
        </h1>
        <p style="display: none;">
          Más de 40 años de experiencia en ejecución, comercialización y
          proyección de edificios premium para inversión.
        </p>
      </section>
      <!-- <Navbar client:load /> -->
      <slot />
      <!-- <FooterTop />
      <FooterMed />
      <FooterBottom /> -->
    </main>

    <script type="module" src="/src/scripts/count-up.ts"></script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
