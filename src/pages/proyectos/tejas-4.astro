---

<Layout>
  <Navbar
    client:visible
    navLinks={["Ubicación", "Características", "Detalles", "Contacto"]}
    isProjectPage={true}
    homeUrl="/"
    proyectosSubmenu={[
      { label: "Wissen DF", href: "/proyectos/wissen-df" },
      { label: "Tejas 4", href: "/proyectos/tejas-4" },
    ]}
  />
  <HeroProyecto
    client:load
    title={TEJAS4.hero.title}
    subtitle={TEJAS4.hero.subtitle}
    heroImage={TEJAS4.hero.heroImage}
    whatsappMessage={TEJAS4.hero.whatsappMessage}
    phone={TEJAS4.hero.phone}
  />
  <UbicacionProyecto
    client:load
    address={TEJAS4.ubicacion.address}
    addressDetail={TEJAS4.ubicacion.addressDetail}
    mapEmbedUrl={TEJAS4.ubicacion.mapEmbedUrl}
    mapLink={TEJAS4.ubicacion.mapLink}
    description={TEJAS4.ubicacion.description}
    amenities={TEJAS4.ubicacion.amenities}
    stats={TEJAS4.ubicacion.stats}
  />
  <CaracteristicasProyecto
    client:load
    images={TEJAS4.caracteristicas.images}
    characteristics={TEJAS4.caracteristicas.characteristics}
    introTitle={TEJAS4.caracteristicas.introTitle}
    introText={TEJAS4.caracteristicas.introText}
  />
  <DetallesProyecto client:load items={TEJAS4.detalles} />
  <FinanciamientoProyecto
    client:load
    showPrecioTitle={TEJAS4.financiamiento.showPrecioTitle}
    showEntregaCuotas={TEJAS4.financiamiento.showEntregaCuotas}
    estadoBadge={TEJAS4.financiamiento.estadoBadge}
    slogan={TEJAS4.financiamiento.slogan}
    whatsappMessage={TEJAS4.financiamiento.whatsappMessage}
    phone={TEJAS4.financiamiento.phone}
    buttonText={TEJAS4.financiamiento.buttonText}
  />
  <FooterProyecto
    client:load
    projectName={TEJAS4.footer.projectName}
    projectNameHighlight={TEJAS4.footer.projectNameHighlight}
    projectDescription={TEJAS4.footer.projectDescription}
    address={TEJAS4.footer.address}
    phone={TEJAS4.footer.phone}
    phoneFormatted={TEJAS4.footer.phoneFormatted}
    email={TEJAS4.footer.email}
    whatsappMessage={TEJAS4.footer.whatsappMessage}
    instagramUrl={TEJAS4.footer.instagramUrl}
    showExperienceBlock={TEJAS4.footer.showExperienceBlock}
  />
</Layout>
